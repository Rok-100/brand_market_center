HOST_PORT=3766
PERSON_HOST_PORT=3767
WORKBENCH_IMAGE=fd-026222-brand-marketing-workbench:2.11.39
PRODUCT_GEOMETRY_IMAGE=fd-026222-product-geometry:1.0.0
PUBLIC_URL=
RUN_UID=1000
RUN_GID=1000

# 一键做同款 OpenCV 几何服务。默认由 docker-compose 内网服务提供。
ONE_CLICK_REMAKE_GEOMETRY_TIMEOUT_MS=30000
PRODUCT_GEOMETRY_MAX_DOWNLOAD_BYTES=26214400
PRODUCT_GEOMETRY_DOWNLOAD_TIMEOUT_SECONDS=20

# 在服务器生成并保存，禁止提交到镜像或聊天中。
AI_WORKBENCH_INTERNAL_TOKEN=
WIS_QIANCHUAN_SECRET_KEY=

# 中枢统一权限。工作台登录后使用已验证身份二次复核 ai-first-creation 权限。
WIS_CENTRAL_ACCESS_URL=https://app.fandow.top/fd-026222/wis-video-center/api/workstation/access-authorize-identity
WIS_WORKSTATION_API_TOKEN=
WIS_CENTRAL_MODULE=ai-first-creation
WIS_CENTRAL_ACCESS_CACHE_MS=15000

# 公司素材数据库。密码通过服务器私密 .env 注入，不进入镜像。
AI_MATERIAL_DB_HOST=
AI_MATERIAL_DB_PORT=3306
AI_MATERIAL_DB_USER=
AI_MATERIAL_DB_PASSWORD=
AI_MATERIAL_DB_NAME=

# 公司 OSS 共享资产存储。真实鉴权由服务器网关负责，不向前端暴露密钥。
AI_MATERIAL_OSS_ORIGIN=https://oss.fandow.com
AI_MATERIAL_OSS_BUCKET=marketing-video-dashboard
AI_MATERIAL_OSS_PREFIX=yxb/workbench
AI_MATERIAL_OSS_WRITE_ENABLED=true

# 可选的模型服务凭据。
ARK_API_KEY=
VOLCENGINE_API_KEY=
GEMINI_API_KEY=
KOC_GPT_IMAGE_TOKEN=
# FanDo UAC accessToken。服务端用它调用 /v1/agent-token，换取 JenVideo gen_token。
JENVIDEO_UAC_TOKEN=
# 旧版兼容项；新部署请使用 JENVIDEO_UAC_TOKEN。
FANDO_PROVIDER_API_KEY=

# Server-side speech transcription. Never expose this key to browser code.
XingChenASR=
SILICONFLOW_ASR_MODEL=XingChenAGI/XingChenASR-Diarize-V3.0
SILICONFLOW_ASR_BASE_URL=https://api.siliconflow.cn/v1

# AI产展参考图反推提示词。使用服务器端配置，禁止写入前端页面。
QWEN_IMAGE_PROMPT_BASE_URL=
QWEN_IMAGE_PROMPT_ENDPOINT=/v1/chat/completions
QWEN_IMAGE_PROMPT_MODEL=qwen3.7-plus
QWEN_IMAGE_PROMPT_API_KEY=

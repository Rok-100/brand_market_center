# 复制为项目根目录 .env。默认值可直接用于本地模拟。
# 实际地址和密钥只填写在 .env 中，该文件不会提交到 Git。

# 浏览器访问端口，按自己电脑情况填写。
HUB_PORT=8095

# 默认使用独立的完整环境项目，不覆盖旧模拟项目。
COMPOSE_PROJECT_NAME=brand-market-full
COMPOSE_PARALLEL_LIMIT=1

# 完整环境自动启动本地数据库和存储网关，密码由 setup 随机生成。
# 二创媒体保存在 remix-data 卷，受管元数据通过本地存储网关保存。
# input-data 是混剪辅助模拟服务的数据卷。
# 以下是 Docker 卷名，通常不用改；改名会切换到另一个数据卷，不会迁移旧数据。
REMIX_DATA_VOLUME=brand-market-full_remix-data
INPUT_DATA_VOLUME=brand-market-full_input-data

# 工作台内部签名密钥。此处是公开的本地示例值，可自行更换。
RENDER_WORKER_SHARED_SECRET=local-development-workstation-shared-token-20261023
# 默认本地模式下，下方工作台令牌、素材客户端令牌与上述值保持一致。
WIS_WORKSTATION_API_TOKEN=local-development-workstation-shared-token-20261023

# 素材库服务：同时用于读取素材和回传成片。
# 对接已有素材库时填写其 /api/remix-workstation 接口地址和令牌。
# 令牌至少 32 字符。接口协议见 config/libraries.md。
WIS_MATERIAL_CENTER_BASE_URL=http://cloud:3000/api/remix-workstation
WIS_MATERIAL_CENTER_TOKEN=local-development-workstation-shared-token-20261023
WIS_MATERIAL_CENTER_READ_TIMEOUT_MS=60000
WIS_MATERIAL_CENTER_READ_MAX_ATTEMPTS=3
WIS_MATERIAL_CENTER_READ_RETRY_DELAY_MS=1000

# 混剪辅助模拟服务生成的内部地址，通常不需要修改。
LOCAL_LIBRARY_BASE_URL=http://bridge:3000

# 文案拆解/识别服务。默认使用本地模拟接口。
WIS_CUTTER_BASE_URL=http://cutter-fixture:3000

# 自动混剪视觉服务。默认使用本地模拟接口。
# 真实服务需兼容当前 fandow 协议，而非任意 OpenAI 接口。
WIS_REMIX_VISUAL_REVIEW_ENABLED=true
WIS_REMIX_VISION_PROVIDER=fandow
JUMP_LLM_URL=http://bridge:3000/vision
JUMP_LLM_TOKEN=local-simulation
JUMP_LLM_APPLICATION=local-remix
JUMP_LLM_PROVIDER=local-simulation
JUMP_LLM_VISION_MODEL=local-simulation-vision

# 可选直连视觉模型。启用时设 WIS_REMIX_VISION_PROVIDER=deepseek-direct。
# 此模式不使用上面的 JUMP_LLM_* 参数。
DEEPSEEK_API_KEY=
DEEPSEEK_VISION_MODEL=deepseek-flash

# 自动任务和资源并发：内存有限的电脑保持 1。
WIS_REMIX_AUTOMATION_ENABLED=1
RENDER_WORKER_PROCESS_MAX_CONCURRENCY=1
RENDER_WORKER_OCR_MAX_CONCURRENCY=1
RENDER_WORKER_CPU_MAX_CONCURRENCY=1
